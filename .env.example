OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATA_DIR=data
EMBEDDING_CACHE=work/models

# Local trained reranker: Xenova/ms-marco-MiniLM-L-6-v2 (downloaded on first use).

# Optional read-only sandbox; never commit real credentials.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
COOKIE_SECURE=false

# Optional managed dense search; local fallback on unavailable/unsynced Pinecone.
VECTOR_BACKEND=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=customer-case-intelligence
# Create an existing serverless index with dimension=384 and metric=cosine.
# Run python scripts/sync_pinecone.py after configuring the private .env.
